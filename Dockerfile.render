# Quarto rendering container - extends the main Julia image with Quarto and bash entrypoint
# Used by: nix run .#render
# Original Dockerfile is unchanged and used by all other nix run commands

FROM julia:1.11-bookworm

# Quarto version (update this as new versions are released)
ARG QUARTO_VERSION=1.8.27

# Create a working directory within the container
WORKDIR /workdir

# Install build tools, Quarto dependencies, and Jupyter/Python
RUN apt-get update && \
    apt-get -y install \
    gcc \
    make \
    curl \
    gdebi-core \
    python3 \
    python3-pip \
    python3-venv
    # libcurl4-openssl-dev \
    # libexpat1-dev

# Install Jupyter via pip
RUN pip3 install jupyter --break-system-packages

# Install Quarto for notebook rendering
RUN curl -LO https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-amd64.deb && \
    gdebi --non-interactive quarto-${QUARTO_VERSION}-linux-amd64.deb && \
    rm quarto-${QUARTO_VERSION}-linux-amd64.deb

# Install WFDB tools
ADD https://www.physionet.org/physiotools/archives/wfdb-10.7/wfdb-10.7.0.tar.gz wfdb-10.7.0.tar.gz
RUN tar -xzf wfdb-10.7.0.tar.gz && rm wfdb-10.7.0.tar.gz
RUN cd wfdb-10.7.0 && ./configure && make install && cd ..

COPY Project.toml Manifest.toml /workdir/

# Environment variables
ENV DISPLAY=${DISPLAY:-:0}
ENV LD_LIBRARY_PATH="/run/opengl-driver/lib"

# Fix Manifest.toml julia_version using Julia to ensure correct TOML parsing
RUN julia << 'EOF'
using TOML

manifest_path = "/workdir/Manifest.toml"
manifest = TOML.parsefile(manifest_path)

# Update julia_version to match container's Julia
manifest["julia_version"] = string(VERSION)
manifest["manifest_format"] = "2.0"

# Write back to file
open(manifest_path, "w") do io
    TOML.print(io, manifest)
end

println("Updated Manifest.toml julia_version to $(VERSION)")
EOF

# Now instantiate and resolve packages
RUN julia -e 'using Pkg; Pkg.activate("/workdir"); Pkg.instantiate(); Pkg.resolve()'

# Save Manifest to safe location (won't be overwritten by Docker volume mount)
RUN cp /workdir/Manifest.toml /.manifest_backup

# Precompile HeartRateLab to avoid slow first execution in notebooks
RUN julia --project=/workdir -e 'using Pkg; Pkg.precompile()' 2>&1 | grep -v "function_registry" || true

# Install and register IJulia kernel for Jupyter/Quarto
# The kernel MUST use the /workdir project so HeartRateLab is available
RUN julia --project=/workdir -e 'using Pkg; Pkg.add("IJulia"); using IJulia; IJulia.installkernel("Julia", env=Dict("JULIA_PROJECT"=>"/workdir"))'

# Configure kernel to use --project=/workdir by modifying kernel.json
# This ensures Jupyter always uses the /workdir project for package resolution
RUN sed -i 's|"/usr/local/julia/bin/julia",|"/usr/local/julia/bin/julia", "--project=/workdir",|' /root/.local/share/jupyter/kernels/julia-1.11/kernel.json

# Use bash as entrypoint to allow flexible command execution
# For quarto rendering: docker run hrlab:render bash -c 'quarto render ...'
ENTRYPOINT [ "bash" ]
