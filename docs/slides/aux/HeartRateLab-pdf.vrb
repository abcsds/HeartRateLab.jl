\begin{block}{Preprocessing}
\phantomsection\label{preprocessing}
\begin{itemize}
\tightlist
\item
  Replace Zeros
\item
  Replace biological outliers (200 to 3000 ms) and breaks
\item
  Replace statistical outliers (Z(0.025, 0.975))
\item
  Ectopic beat detection:

  \begin{itemize}
  \tightlist
  \item
    ACAR
  \item
    Karlsson
  \item
    Malik
  \item
    Kamath
  \item
    Custom absolute threshold (0.2)
  \end{itemize}
\item
  Signal interpolation:

  \begin{itemize}
  \tightlist
  \item
    Constant
  \item
    Linear
  \item
    Quadratic
  \item
    Cubic
  \end{itemize}
\item
  Windowed analysis:

  \begin{itemize}
  \tightlist
  \item
    Sliding window
  \item
    Overlapping windows
  \item
    Non-overlapping windows
  \end{itemize}
\end{itemize}
\end{block}
