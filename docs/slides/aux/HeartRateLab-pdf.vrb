\end{columns}

\begin{block}{Visualization}
\phantomsection\label{visualization}
\begin{Shaded}
\begin{Highlighting}[]
\CommentTok{\# A histogram of the first 50 heartbeats}
\NormalTok{f }\OperatorTok{=} \FunctionTok{Figure}\NormalTok{(size}\OperatorTok{=}\NormalTok{(}\FloatTok{600}\NormalTok{, }\FloatTok{600}\NormalTok{));}
\NormalTok{ax }\OperatorTok{=} \FunctionTok{Axis}\NormalTok{(f[}\FloatTok{1}\NormalTok{, }\FloatTok{1}\NormalTok{], }
\NormalTok{    title}\OperatorTok{=}\StringTok{"Histogram of measured Heart Rate"}\NormalTok{,}
\NormalTok{    xlabel}\OperatorTok{=}\StringTok{"Heart Rate (bpm)"}\NormalTok{,}
\NormalTok{    ylabel}\OperatorTok{=}\StringTok{"Frequency"}\NormalTok{)}
\NormalTok{n }\OperatorTok{=}\NormalTok{ data[}\FloatTok{1}\OperatorTok{:}\FloatTok{50}\NormalTok{]}
\NormalTok{t }\OperatorTok{=} \FunctionTok{Observable}\NormalTok{(}\FunctionTok{cumsum}\NormalTok{(n) }\OperatorTok{./} \FloatTok{1000}\NormalTok{) }\CommentTok{\# to seconds}
\NormalTok{x }\OperatorTok{=} \FunctionTok{Observable}\NormalTok{(}\FloatTok{60000} \OperatorTok{./}\NormalTok{ n) }\CommentTok{\# to bpm}
\FunctionTok{hist!}\NormalTok{(ax, x, bins}\OperatorTok{=}\FloatTok{20}\NormalTok{, color}\OperatorTok{=:}\NormalTok{teal)}
\FunctionTok{vlines!}\NormalTok{(ax, }\FunctionTok{mean}\NormalTok{(x[]), color}\OperatorTok{=:}\NormalTok{red, linewidth}\OperatorTok{=}\FloatTok{2}\NormalTok{, label}\OperatorTok{=}\StringTok{"Mean"}\NormalTok{)}

\FunctionTok{display}\NormalTok{(f)}
\end{Highlighting}
\end{Shaded}

\phantomsection\label{histogram}
\begin{verbatim}
GLMakie.Screen(...)
\end{verbatim}
\end{block}
\end{block}

\begin{block}{RMSSD}
\phantomsection\label{rmssd}
\begin{columns}[T]
\begin{column}{0.5\linewidth}
\begin{Shaded}
\begin{Highlighting}[]
\NormalTok{f }\OperatorTok{=} \FunctionTok{Figure}\NormalTok{(size}\OperatorTok{=}\NormalTok{(}\FloatTok{600}\NormalTok{, }\FloatTok{600}\NormalTok{));}
\NormalTok{ax }\OperatorTok{=} \FunctionTok{Axis}\NormalTok{(f[}\FloatTok{1}\NormalTok{, }\FloatTok{1}\NormalTok{], }
\NormalTok{    title}\OperatorTok{=}\StringTok{"Difference of Sequential Heart Rates"}\NormalTok{,}
\NormalTok{    xlabel}\OperatorTok{=}\StringTok{"Time (s)"}\NormalTok{,}
\NormalTok{    ylabel}\OperatorTok{=}\StringTok{"Heart Rate (bpm)"}\NormalTok{)}
\NormalTok{n }\OperatorTok{=}\NormalTok{ data[}\FloatTok{1}\OperatorTok{:}\FloatTok{50}\NormalTok{]}
\NormalTok{t }\OperatorTok{=} \FunctionTok{Observable}\NormalTok{(}\FunctionTok{cumsum}\NormalTok{(n) }\OperatorTok{./} \FloatTok{1000}\NormalTok{) }\CommentTok{\# to seconds}
\NormalTok{x }\OperatorTok{=} \FunctionTok{Observable}\NormalTok{([}\FloatTok{0}\NormalTok{; }\FunctionTok{diff}\NormalTok{(n)])}
\NormalTok{x\_above\_zero }\OperatorTok{=} \FunctionTok{Observable}\NormalTok{(}\FunctionTok{clamp}\NormalTok{.(x[], }\FloatTok{0}\NormalTok{, }\ConstantTok{Inf}\NormalTok{))}
\NormalTok{x\_below\_zero }\OperatorTok{=} \FunctionTok{Observable}\NormalTok{(}\FunctionTok{clamp}\NormalTok{.(x[], }\OperatorTok{{-}}\ConstantTok{Inf}\NormalTok{, }\FloatTok{0}\NormalTok{))}
\NormalTok{zero\_line }\OperatorTok{=} \FunctionTok{Observable}\NormalTok{(}\FunctionTok{zeros}\NormalTok{(}\FunctionTok{length}\NormalTok{(x[])))}
\FunctionTok{lines!}\NormalTok{(ax, t, x, color}\OperatorTok{=:}\NormalTok{teal)}
\CommentTok{\# Band above zero}
\CommentTok{\# band(x, ylower, yupper; kwargs...)}
\FunctionTok{band!}\NormalTok{(ax, t, zero\_line, x\_above\_zero, }
\NormalTok{    color}\OperatorTok{=:}\NormalTok{teal, alpha}\OperatorTok{=}\FloatTok{0.5}\NormalTok{)}
\FunctionTok{band!}\NormalTok{(ax, t, zero\_line, x\_below\_zero, }
\NormalTok{    color}\OperatorTok{=:}\NormalTok{coral, alpha}\OperatorTok{=}\FloatTok{0.5}\NormalTok{)}
\FunctionTok{scatter!}\NormalTok{(ax, t, x, color}\OperatorTok{=:}\NormalTok{red, markersize}\OperatorTok{=}\FloatTok{5}\NormalTok{)}

\FunctionTok{lines!}\NormalTok{(ax, t, n }\OperatorTok{.{-}} \FunctionTok{mean}\NormalTok{(n), color}\OperatorTok{=:}\NormalTok{blue, linewidth}\OperatorTok{=}\FloatTok{2}\NormalTok{, label}\OperatorTok{=}\StringTok{"Heart Rate"}\NormalTok{)}
\FunctionTok{display}\NormalTok{(f)}
\end{Highlighting}
\end{Shaded}

\phantomsection\label{diff}
\begin{verbatim}
GLMakie.Screen(...)
\end{verbatim}
\end{column}

\begin{column}{0.5\linewidth}
\phantomsection\label{rmssd}
\begin{Shaded}
\begin{Highlighting}[]
\FunctionTok{println}\NormalTok{(}\StringTok{"SDNN: "}\NormalTok{, StatsBase.}\FunctionTok{std}\NormalTok{(x[]))}
\FunctionTok{println}\NormalTok{(}\StringTok{"RMSSD: "}\NormalTok{, StatsBase.}\FunctionTok{std}\NormalTok{(n))}
\end{Highlighting}
\end{Shaded}

