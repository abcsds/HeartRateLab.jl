\begin{column}{0.5\linewidth}
\end{column}

\begin{Shaded}
\begin{Highlighting}[]
\NormalTok{scales, fluc }\OperatorTok{=}\NormalTok{ DFA.}\FunctionTok{dfa}\NormalTok{(data, boxmax}\OperatorTok{=}\FloatTok{64}\NormalTok{, boxmin}\OperatorTok{=}\FloatTok{4}\NormalTok{, boxratio}\OperatorTok{=}\FloatTok{2}\NormalTok{, overlap}\OperatorTok{=}\FloatTok{0.0}\NormalTok{)}
\NormalTok{log\_scales1 }\OperatorTok{=} \FunctionTok{log10}\NormalTok{.(scales)}
\NormalTok{log\_fluc1 }\OperatorTok{=} \FunctionTok{log10}\NormalTok{.(fluc)}
\NormalTok{f }\OperatorTok{=} \FunctionTok{Figure}\NormalTok{(size}\OperatorTok{=}\NormalTok{(}\FloatTok{600}\NormalTok{, }\FloatTok{600}\NormalTok{));}
\NormalTok{ax1 }\OperatorTok{=} \FunctionTok{Axis}\NormalTok{(f[}\FloatTok{1}\NormalTok{, }\FloatTok{1}\NormalTok{], }
\NormalTok{    title}\OperatorTok{=}\StringTok{"Log{-}scale Fluctuation 4{-}64"}\NormalTok{,}
\NormalTok{    xlabel}\OperatorTok{=}\StringTok{"log10(Scale)"}\NormalTok{,}
\NormalTok{    ylabel}\OperatorTok{=}\StringTok{"log10(Fluctuation)"}\NormalTok{,}
\NormalTok{)}
\FunctionTok{scatter!}\NormalTok{(ax1, log\_scales1, log\_fluc1, color}\OperatorTok{=:}\NormalTok{blue, markersize}\OperatorTok{=}\FloatTok{5}\NormalTok{)}
\NormalTok{intercept1, α}\FloatTok{1} \OperatorTok{=}\NormalTok{ DFA.}\FunctionTok{polyfit}\NormalTok{(log\_scales1, log\_fluc1)}
\NormalTok{x }\OperatorTok{=} \FunctionTok{range}\NormalTok{(}\FunctionTok{minimum}\NormalTok{(log\_scales1), }\FunctionTok{maximum}\NormalTok{(log\_scales1), length}\OperatorTok{=}\FloatTok{100}\NormalTok{)}
\NormalTok{y }\OperatorTok{=}\NormalTok{ intercept1 }\OperatorTok{.+}\NormalTok{ α}\FloatTok{1} \OperatorTok{.*}\NormalTok{ x}
\FunctionTok{lines!}\NormalTok{(ax1, x, y, color}\OperatorTok{=:}\NormalTok{red, linewidth}\OperatorTok{=}\FloatTok{1}\NormalTok{, linestyle}\OperatorTok{=:}\NormalTok{dash)}
\CommentTok{\# display(f)}

\NormalTok{scales, fluc }\OperatorTok{=}\NormalTok{ DFA.}\FunctionTok{dfa}\NormalTok{(data, boxmax}\OperatorTok{=}\FloatTok{16}\NormalTok{, boxmin}\OperatorTok{=}\FloatTok{4}\NormalTok{, boxratio}\OperatorTok{=}\FloatTok{2}\NormalTok{, overlap}\OperatorTok{=}\FloatTok{0.0}\NormalTok{)}
\NormalTok{log\_scales2 }\OperatorTok{=} \FunctionTok{log10}\NormalTok{.(scales)}
\NormalTok{log\_fluc2 }\OperatorTok{=} \FunctionTok{log10}\NormalTok{.(fluc)}
\NormalTok{ax2 }\OperatorTok{=} \FunctionTok{Axis}\NormalTok{(f[}\FloatTok{1}\NormalTok{, }\FloatTok{2}\NormalTok{], }
\NormalTok{    title}\OperatorTok{=}\StringTok{"Log{-}scale Fluctuation 4{-}16"}\NormalTok{,}
\NormalTok{    xlabel}\OperatorTok{=}\StringTok{"log10(Scale)"}\NormalTok{,}
\NormalTok{    ylabel}\OperatorTok{=}\StringTok{"log10(Fluctuation)"}\NormalTok{,}
\NormalTok{)}
\FunctionTok{scatter!}\NormalTok{(ax2, }\FunctionTok{log10}\NormalTok{.(scales), }\FunctionTok{log10}\NormalTok{.(fluc), color}\OperatorTok{=:}\NormalTok{blue, markersize}\OperatorTok{=}\FloatTok{5}\NormalTok{)}
\NormalTok{intercept2, α}\FloatTok{2} \OperatorTok{=}\NormalTok{ DFA.}\FunctionTok{polyfit}\NormalTok{(log\_scales2, log\_fluc2)}
\NormalTok{x }\OperatorTok{=} \FunctionTok{range}\NormalTok{(}\FunctionTok{minimum}\NormalTok{(log\_scales2), }\FunctionTok{maximum}\NormalTok{(log\_scales2), length}\OperatorTok{=}\FloatTok{100}\NormalTok{)}
\NormalTok{y }\OperatorTok{=}\NormalTok{ intercept2 }\OperatorTok{.+}\NormalTok{ α}\FloatTok{2} \OperatorTok{.*}\NormalTok{ x}
\FunctionTok{lines!}\NormalTok{(ax2, x, y, color}\OperatorTok{=:}\NormalTok{red, linewidth}\OperatorTok{=}\FloatTok{1}\NormalTok{, linestyle}\OperatorTok{=:}\NormalTok{dash)}
\FunctionTok{linkxaxes!}\NormalTok{(ax1, ax2)}
\FunctionTok{linkyaxes!}\NormalTok{(ax1, ax2)}
\FunctionTok{display}\NormalTok{(f)}
\end{Highlighting}
\end{Shaded}

