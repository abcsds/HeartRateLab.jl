\begin{block}{Geometric Domain}
\phantomsection\label{geometric-domain}
\begin{columns}[T]
\begin{column}{0.5\linewidth}
\begin{itemize}
\tightlist
\item
  Poincaré Plot

  \begin{itemize}
  \tightlist
  \item
    SD1: Short-term variability
  \item
    SD2: Long-term variability
  \item
    SD1/SD2 ratio, area
  \item
    cvi
  \item
    ccsi
  \end{itemize}
\item
  Histogram Based:

  \begin{itemize}
  \tightlist
  \item
    Triangular Index
  \item
    Tinn
  \end{itemize}
\end{itemize}
\end{column}

\begin{column}{0.5\linewidth}
\begin{Shaded}
\begin{Highlighting}[]
\KeywordTok{function} \FunctionTok{getellipsepoints}\NormalTok{(cx, cy, rx, ry, θ)}
\NormalTok{    t }\OperatorTok{=} \FunctionTok{range}\NormalTok{(}\FloatTok{0}\NormalTok{, }\FloatTok{2}\OperatorTok{*}\ConstantTok{pi}\NormalTok{, length}\OperatorTok{=}\FloatTok{100}\NormalTok{)}
\NormalTok{    ellipse\_x\_r }\OperatorTok{=}\NormalTok{ @. rx }\OperatorTok{*} \FunctionTok{cos}\NormalTok{(t)}
\NormalTok{    ellipse\_y\_r }\OperatorTok{=}\NormalTok{ @. ry }\OperatorTok{*} \FunctionTok{sin}\NormalTok{(t)}
\NormalTok{    R }\OperatorTok{=}\NormalTok{ [}\FunctionTok{cos}\NormalTok{(θ) }\FunctionTok{sin}\NormalTok{(θ); }\FunctionTok{{-}sin}\NormalTok{(θ) }\FunctionTok{cos}\NormalTok{(θ)]}
\NormalTok{    r\_ellipse }\OperatorTok{=}\NormalTok{ [ellipse\_x\_r ellipse\_y\_r] }\OperatorTok{*}\NormalTok{ R}
\NormalTok{    x }\OperatorTok{=}\NormalTok{ @. cx }\OperatorTok{+}\NormalTok{ r\_ellipse[}\OperatorTok{:}\NormalTok{,}\FloatTok{1}\NormalTok{]}
\NormalTok{    y }\OperatorTok{=}\NormalTok{ @. cy }\OperatorTok{+}\NormalTok{ r\_ellipse[}\OperatorTok{:}\NormalTok{,}\FloatTok{2}\NormalTok{]}
\NormalTok{    (x,y)}
\KeywordTok{end}
\NormalTok{x }\OperatorTok{=}\NormalTok{ [data[i] for i }\KeywordTok{in} \FloatTok{1}\OperatorTok{:}\FunctionTok{length}\NormalTok{(data)}\OperatorTok{{-}}\FloatTok{1}\NormalTok{]}
\NormalTok{y }\OperatorTok{=}\NormalTok{ [data[i}\OperatorTok{+}\FloatTok{1}\NormalTok{] for i }\KeywordTok{in} \FloatTok{1}\OperatorTok{:}\FunctionTok{length}\NormalTok{(data)}\OperatorTok{{-}}\FloatTok{1}\NormalTok{]}
\NormalTok{sd1 }\OperatorTok{=} \FunctionTok{sqrt}\NormalTok{(StatsBase.}\FunctionTok{var}\NormalTok{((x }\OperatorTok{{-}}\NormalTok{ y) }\OperatorTok{/} \FunctionTok{sqrt}\NormalTok{(}\FloatTok{2}\NormalTok{)))}
\NormalTok{sd2 }\OperatorTok{=} \FunctionTok{sqrt}\NormalTok{(StatsBase.}\FunctionTok{var}\NormalTok{((x }\OperatorTok{+}\NormalTok{ y) }\OperatorTok{/} \FunctionTok{sqrt}\NormalTok{(}\FloatTok{2}\NormalTok{)))}
\NormalTok{f }\OperatorTok{=} \FunctionTok{Figure}\NormalTok{(size}\OperatorTok{=}\NormalTok{(}\FloatTok{600}\NormalTok{, }\FloatTok{600}\NormalTok{));}
\NormalTok{ax }\OperatorTok{=} \FunctionTok{Axis}\NormalTok{(f[}\FloatTok{1}\NormalTok{, }\FloatTok{1}\NormalTok{], }
\NormalTok{    title}\OperatorTok{=}\StringTok{"Poincaré Plot"}\NormalTok{,}
\NormalTok{    xlabel}\OperatorTok{=}\StringTok{"RR(n) (ms)"}\NormalTok{,}
\NormalTok{    ylabel}\OperatorTok{=}\StringTok{"RR(n+1) (ms)"}\NormalTok{)}
\FunctionTok{scatter!}\NormalTok{(ax, x, y, markersize}\OperatorTok{=}\FloatTok{5}\NormalTok{, label}\OperatorTok{=}\StringTok{"ΔRR[i, i+1]"}\NormalTok{)}
\NormalTok{cx }\OperatorTok{=} \FunctionTok{mean}\NormalTok{(x)}
\NormalTok{cy }\OperatorTok{=} \FunctionTok{mean}\NormalTok{(y)}
\NormalTok{ellipse\_x, ellipse\_y }\OperatorTok{=} \FunctionTok{getellipsepoints}\NormalTok{(cx, cy, sd2, sd1, }\ConstantTok{π}\OperatorTok{/}\FloatTok{4}\NormalTok{)}
\FunctionTok{lines!}\NormalTok{(ax, ellipse\_x, ellipse\_y, linewidth}\OperatorTok{=}\FloatTok{2}\NormalTok{, label}\OperatorTok{=}\StringTok{"Variance Ellipse"}\NormalTok{, color}\OperatorTok{=:}\NormalTok{coral)}
\NormalTok{f[}\FloatTok{1}\NormalTok{,}\FloatTok{2}\NormalTok{] }\OperatorTok{=} \FunctionTok{Legend}\NormalTok{(f, ax, }\StringTok{"Poincaré Plot"}\NormalTok{,}
\NormalTok{    position}\OperatorTok{=:}\NormalTok{bottomright, }
\NormalTok{    title}\OperatorTok{=}\StringTok{"Poincaré Plot Legend"}\NormalTok{,}
\NormalTok{    fontsize}\OperatorTok{=}\FloatTok{10}\NormalTok{,}
\NormalTok{    bgcolor}\OperatorTok{=:}\NormalTok{white,}
\NormalTok{    framecolor}\OperatorTok{=:}\NormalTok{black)}

\FunctionTok{display}\NormalTok{(f)}
\end{Highlighting}
\end{Shaded}

\phantomsection\label{poincare}
\begin{verbatim}
GLMakie.Screen(...)
\end{verbatim}
\end{column}
\end{columns}
\end{block}

