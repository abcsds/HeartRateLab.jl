    "tp" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td><font color="#e8912a" point-size="15">&#9679;</font></td><td width="5"></td><td><font color="#222736">tp</font></td></tr></table>>, fillcolor="white", color="#2f8a44", fontcolor="#222736"];
    "lf_peak" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td><font color="#4c78d8" point-size="15">&#9679;</font></td><td width="5"></td><td><font color="#222736">lf_peak</font></td></tr></table>>, fillcolor="white", color="#2f8a44", fontcolor="#222736"];
