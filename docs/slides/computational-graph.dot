digraph HRL {
  rankdir=TB; bgcolor="white"; nodesep=0.24; ranksep="0.42 equally";
  splines=spline; compound=true; newrank=true; pad=0.3;
  labelloc="t"; fontname="Helvetica-Bold"; fontsize=25;
  label=<<b>HeartRateLab &#8212; Feature Computational Graph</b><br/><font point-size="13" color="#5b6172">One IBI series &#8594; 11 memoised representations &#8594; 53 HRV features. Every arrow is an &#8220;is computed from&#8221; dependency.</font><br/> >;
  node  [shape=box, style="rounded,filled", fontname="Helvetica-Bold", fontsize=12, height=0.34, margin="0.10,0.045", penwidth=1.7];
  edge  [penwidth=1.7, arrowsize=0.72];
  RawData [label=<<b>RawData</b><br/><font point-size="9">IBI / RR series</font>>, shape=box, style="rounded,filled", fillcolor="#1b2237", fontcolor="#eef1f8", penwidth=0, width=1.5, height=1.0];
  subgraph cluster_time {
    label=<<b>Time &amp; Statistics</b>>; labeljust="l"; fontsize=15; fontcolor="#7c53c9"; style="rounded,filled"; fillcolor="#efe9fb"; color="#7c53c9"; penwidth=1.6; margin=12;
    "mean" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td><font color="#4c78d8" point-size="15">&#9679;</font></td><td width="5"></td><td><font color="#222736">mean</font></td></tr></table>>, fillcolor="white", color="#7c53c9", fontcolor="#222736"];
    "sdnn" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td><font color="#e8912a" point-size="15">&#9679;</font></td><td width="5"></td><td><font color="#222736">sdnn</font></td></tr></table>>, fillcolor="white", color="#7c53c9", fontcolor="#222736"];
    "median" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td><font color="#4c78d8" point-size="15">&#9679;</font></td><td width="5"></td><td><font color="#222736">median</font></td></tr></table>>, fillcolor="white", color="#7c53c9", fontcolor="#222736"];
    "max" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td><font color="#4c78d8" point-size="15">&#9679;</font></td><td width="5"></td><td><font color="#222736">max</font></td></tr></table>>, fillcolor="white", color="#7c53c9", fontcolor="#222736"];
    "min" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td><font color="#4c78d8" point-size="15">&#9679;</font></td><td width="5"></td><td><font color="#222736">min</font></td></tr></table>>, fillcolor="white", color="#7c53c9", fontcolor="#222736"];
    "diff" [label="diff", fillcolor="#7c53c9", color="#7c53c9", fontcolor="white"];
    "length" [label="length", fillcolor="#7c53c9", color="#7c53c9", fontcolor="white"];
    "duration" [label="duration", fillcolor="#7c53c9", color="#7c53c9", fontcolor="white"];
    "mean_hr" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td><font color="#4c78d8" point-size="15">&#9679;</font></td><td width="5"></td><td><font color="#222736">mean_hr</font></td></tr></table>>, fillcolor="white", color="#7c53c9", fontcolor="#222736"];
    "sdann" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td><font color="#e8912a" point-size="15">&#9679;</font></td><td width="5"></td><td><font color="#222736">sdann</font></td></tr></table>>, fillcolor="white", color="#7c53c9", fontcolor="#222736"];
    "cvnni" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td><font color="#4c78d8" point-size="15">&#9679;</font></td><td width="5"></td><td><font color="#222736">cvnni</font></td></tr></table>>, fillcolor="white", color="#7c53c9", fontcolor="#222736"];
    "std_hr" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td><font color="#e8912a" point-size="15">&#9679;</font></td><td width="5"></td><td><font color="#222736">std_hr</font></td></tr></table>>, fillcolor="white", color="#7c53c9", fontcolor="#222736"];
    "median_hr" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td><font color="#4c78d8" point-size="15">&#9679;</font></td><td width="5"></td><td><font color="#222736">median_hr</font></td></tr></table>>, fillcolor="white", color="#7c53c9", fontcolor="#222736"];
    "max_hr" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td><font color="#4c78d8" point-size="15">&#9679;</font></td><td width="5"></td><td><font color="#222736">max_hr</font></td></tr></table>>, fillcolor="white", color="#7c53c9", fontcolor="#222736"];
    "range" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td><font color="#e8912a" point-size="15">&#9679;</font></td><td width="5"></td><td><font color="#222736">range</font></td></tr></table>>, fillcolor="white", color="#7c53c9", fontcolor="#222736"];
    "range_hr" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td><font color="#e8912a" point-size="15">&#9679;</font></td><td width="5"></td><td><font color="#222736">range_hr</font></td></tr></table>>, fillcolor="white", color="#7c53c9", fontcolor="#222736"];
    "min_hr" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td><font color="#4c78d8" point-size="15">&#9679;</font></td><td width="5"></td><td><font color="#222736">min_hr</font></td></tr></table>>, fillcolor="white", color="#7c53c9", fontcolor="#222736"];
