    "rmssd" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td><font color="#e8912a" point-size="15">&#9679;</font></td><td width="5"></td><td><font color="#222736">rmssd</font></td></tr></table>>, fillcolor="white", color="#7c53c9", fontcolor="#222736"];
    "pnn50" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td><font color="#4e9a4e" point-size="15">&#9679;</font></td><td width="5"></td><td><font color="#222736">pnn50</font></td></tr></table>>, fillcolor="white", color="#7c53c9", fontcolor="#222736"];
    "pnn20" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td><font color="#4e9a4e" point-size="15">&#9679;</font></td><td width="5"></td><td><font color="#222736">pnn20</font></td></tr></table>>, fillcolor="white", color="#7c53c9", fontcolor="#222736"];
    "rRR" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td><font color="#e8912a" point-size="15">&#9679;</font></td><td width="5"></td><td><font color="#222736">rRR</font></td></tr></table>>, fillcolor="white", color="#7c53c9", fontcolor="#222736"];
    "cvsd" [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="0"><tr><td><font color="#e8912a" point-size="15">&#9679;</font></td><td width="5"></td><td><font color="#222736">cvsd</font></td></tr></table>>, fillcolor="white", color="#7c53c9", fontcolor="#222736"];
  }
  subgraph cluster_freq {
    label=<<b>Frequency</b>>; labeljust="l"; fontsize=15; fontcolor="#2f8a44"; style="rounded,filled"; fillcolor="#e6f3e9"; color="#2f8a44"; penwidth=1.6; margin=12;
