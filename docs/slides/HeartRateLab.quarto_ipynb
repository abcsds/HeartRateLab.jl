    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Interbeat Intervals"
      ],
      "id": "c2465cfc"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: true\n",
        "#| output: slide\n",
        "#| label: inter-beat-intervals\n",
        "f = Figure(size=(600, 600));\n",
        "ax = Axis(f[1, 1], \n",
        "    title=\"Raw Data\",\n",
        "    xlabel=\"Time (s)\",\n",
        "    ylabel=\"Heart Rate (bpm)\")\n",
        "n = data[1:50]\n",
        "t = Observable(cumsum(n) ./ 1000) # to seconds\n",
        "# x = Observable(60000 ./ n) # to bpm\n",
        "x = Observable(n)\n",
        "stem!(ax, t, x, color=:blue)\n",
        "# scatter!(ax, t, x, color=:red, markersize=5)\n",
        "display(f)"
      ],
      "id": "inter-beat-intervals",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Heart Rate"
      ],
      "id": "82285b48"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: true\n",
        "#| output: slide\n",
        "#| label: heart-rate\n",
        "f = Figure(size=(600, 600));\n",
        "ax = Axis(f[1, 1], \n",
        "    title=\"Heart Rate from Inter-Beat Intervals\",\n",
        "    xlabel=\"Heart Rate (bpm)\",\n",
        "    ylabel=\"Frequency\")\n",
        "n = data[1:50]\n",
        "t = Observable(cumsum(n) ./ 1000) # to seconds\n",
        "x = Observable(60000 ./ n) # to bpm\n",
        "lines!(ax, t, x, color=:blue, linewidth=2)\n",
        "display(f)"
      ],
      "id": "heart-rate",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "\n",
        "## Time Domain\n",
        "\n",
        ":::: {.columns}\n",
        "::: {.column width=50%}\n",
        "\n",
        "- Mean\n",
        "- Standard Deviation (SDNN)\n",
        "- Median\n",
        "- Extrema and Range\n",
        "- BPM representations\n",
        "\n",
        ":::\n",
        "\n",
        "::: {.column width=50%}\n",
        "\n",
        " - SDSD\n",
        " - RMSSD\n",
        " - SDANN\n",
        " - PNN50, PNN20 and percentages\n",
        " - CVSD\n",
        " - rRR\n",
        "\n",
        ":::\n",
        "\n",
        "::::\n",
        "\n",
        "### Visualization"
      ],
      "id": "8dd6d531"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: true\n",
        "#| output: slide\n",
        "#| label: histogram\n",
        "# A histogram of the first 50 heartbeats\n",
        "f = Figure(size=(600, 600));\n",
        "ax = Axis(f[1, 1], \n",
        "    title=\"Histogram of measured Heart Rate\",\n",
        "    xlabel=\"Heart Rate (bpm)\",\n",
        "    ylabel=\"Frequency\")\n",
        "n = data[1:50]\n",
        "t = Observable(cumsum(n) ./ 1000) # to seconds\n",
        "x = Observable(60000 ./ n) # to bpm\n",
        "hist!(ax, x, bins=20, color=:teal)\n",
        "vlines!(ax, mean(x[]), color=:red, linewidth=2, label=\"Mean\")\n",
        "\n",
        "display(f)"
      ],
      "id": "histogram",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## RMSSD\n",
        "\n",
        ":::: {.columns}\n",
        "\n",
        "::: {.column width=50%}"
      ],
      "id": "62fed05a"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: true\n",
        "#| output: slide\n",
        "#| label: diff\n",
        "f = Figure(size=(600, 600));\n",
        "ax = Axis(f[1, 1], \n",
        "    title=\"Difference of Sequential Heart Rates\",\n",
        "    xlabel=\"Time (s)\",\n",
        "    ylabel=\"Heart Rate (bpm)\")\n",
        "n = data[1:50]\n",
        "t = Observable(cumsum(n) ./ 1000) # to seconds\n",
        "x = Observable([0; diff(n)])\n",
        "x_above_zero = Observable(clamp.(x[], 0, Inf))\n",
        "x_below_zero = Observable(clamp.(x[], -Inf, 0))\n",
        "zero_line = Observable(zeros(length(x[])))\n",
        "lines!(ax, t, x, color=:teal)\n",
        "# Band above zero\n",
        "# band(x, ylower, yupper; kwargs...)\n",
        "band!(ax, t, zero_line, x_above_zero, \n",
        "    color=:teal, alpha=0.5)\n",
        "band!(ax, t, zero_line, x_below_zero, \n",
        "    color=:coral, alpha=0.5)\n",
        "scatter!(ax, t, x, color=:red, markersize=5)\n",
        "\n",
        "lines!(ax, t, n .- mean(n), color=:blue, linewidth=2, label=\"Heart Rate\")\n",
        "display(f)"
      ],
      "id": "diff",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        ":::\n",
        "\n",
        "::: {.column width=50%}"
      ],
      "id": "8dfea64e"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: true\n",
        "#| output: slide\n",
        "#| label: rmssd\n",
        "println(\"SDNN: \", StatsBase.std(x[]))\n",
        "println(\"RMSSD: \", StatsBase.std(n))"
      ],
      "id": "rmssd",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        ":::\n",
        "\n",
        "::::\n",
        "\n",
        "## Frequency Domain\n",
        "\n",
        ":::: {.columns}\n",
        "\n",
        "::: {.column width=50%}\n",
        "\n",
        "::: {}\n",
        "TODO\n",
        "<!-- - Power Spectral Density (PSD) over four frequency bands:\n",
        "    - Very Low Frequency (VLF): 0.003-0.04 Hz\n",
        "    - Low Frequency (LF): 0.04-0.15 Hz\n",
        "    - High Frequency (HF): 0.15-0.4 Hz\n",
        "    - Ultra Low Frequency (ULF): < 0.003 Hz\n",
        "- Absolute and relative power\n",
        "- Peak frequencies\n",
        "- Proportions and ratios (LF/HF, VLF/LF, etc.) -->\n",
        ":::\n",
        "\n",
