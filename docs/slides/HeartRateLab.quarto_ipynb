        "## Windowed Feature Extraction"
      ],
      "id": "017dfabc"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: true\n",
        "#| output: slide\n",
        "#| label: windowed-short\n",
        "ds_windowed = HeartRateLab.Features.windowed_feature_set(\n",
        "    data, features=[\"vlf\", \"rmssd\"], window_size=30, stride=1\n",
        ")\n",
        "\n",
        "ax = Axis(f[2, 1], \n",
        "    title=\"RMSSD through Time WS=30, S=1\",\n",
        "    xlabel=\"Time (s)\",\n",
        "    ylabel=\"RMSSD (ms²)\")\n",
        "x = ds_windowed.rmssd\n",
        "t = 1:length(x)\n",
